[Unit]
Description=Fly-by-WebRTC bridge settings page
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/fly-ground/python/fly_ground_settings.py --host 0.0.0.0 --port 4001 --env-file /etc/fly-ground.env
StateDirectory=fly-ground-settings rpanion-video
StateDirectoryMode=0700
ExecStartPre=/usr/bin/chmod 0755 /var/lib/rpanion-video
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/fly-ground-settings /var/lib/rpanion-video
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
